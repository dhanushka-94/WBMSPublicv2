# =============================================================================
# WATER BILLING MANAGEMENT SYSTEM (WBMS v3) - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="AquaBill by olexto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Colombo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# =============================================================================
# DATABASE CONFIGURATION (MySQL Only)
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=water_billmspro
DB_USERNAME=root
DB_PASSWORD=

# =============================================================================
# SESSION & CACHE CONFIGURATION
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

# =============================================================================
# QUEUE & BROADCASTING
# =============================================================================
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# =============================================================================
# FILESYSTEM & STORAGE
# =============================================================================
FILESYSTEM_DISK=local

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@aquabill.olexto.com"
MAIL_FROM_NAME="AquaBill by olexto"

# =============================================================================
# SMS CONFIGURATION (Notify.lk)
# =============================================================================
SMS_DRIVER=notify_lk
NOTIFYLK_USER_ID=your_user_id_here
NOTIFYLK_API_KEY=your_api_key_here
NOTIFYLK_SENDER_ID=your_sender_id_here
NOTIFYLK_BASE_URL=https://app.notify.lk/api/v1

# SMS Notification Settings
SMS_NOTIFICATIONS_ENABLED=true
SMS_QUEUE_ENABLED=false
SMS_RETRY_ATTEMPTS=3
SMS_RETRY_DELAY=300

# SMS Bill Notifications
SMS_NEW_BILL_ENABLED=true
SMS_DUE_REMINDER_ENABLED=true
SMS_OVERDUE_ALERT_ENABLED=true
SMS_PAYMENT_CONFIRMATION_ENABLED=true
SMS_LATE_FEE_NOTICE_ENABLED=true

# =============================================================================
# REDIS CONFIGURATION (Optional)
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# MEMCACHED CONFIGURATION (Optional)
# =============================================================================
MEMCACHED_HOST=127.0.0.1

# =============================================================================
# AWS CONFIGURATION (Optional)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
VITE_APP_NAME="AquaBill by olexto"

# =============================================================================
# PRODUCTION SETTINGS (For deployment)
# =============================================================================
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=error
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
